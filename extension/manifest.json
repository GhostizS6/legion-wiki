{
  "manifest_version": 3,
  "name": "Legion Wiki",
  "version": "0.1.0",
  "description": "Энциклопедия предметов Legion: вкладка «Вики» в игре и автосбор данных.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://raw.githubusercontent.com/Ghostiz_s6/legion-wiki/main/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["content/*.css"], "matches": ["https://legiongame.gg/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["https://legiongame.gg/c/*"],
      "js": ["content/collector.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://legiongame.gg/c/*"],
      "js": ["shared/merge.js", "content/model.js", "content/rating.js", "content/app.js", "content/boot.js"],
      "run_at": "document_idle"
    }
  ]
}
